{
  "name": "glassmarshmallow-site",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run values -- --watch & ng serve --port 4500",
    "build": "ng build",
    "build:site": "npm run prebuild && node scripts/build-site.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "icons:svg": "node scripts/copy-icons.mjs",
    "llms": "node ../build/build-llms.mjs",
    "values": "node ../bin/glassmarshmallow.mjs build --content src --out src/glassmarshmallow.extra.css",
    "prestart": "npm run icons:svg && npm run llms",
    "prebuild": "npm run icons:svg && npm run llms && npm run values"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/platform-server": "21.2.25",
    "@angular/router": "21.2.25",
    "@angular/ssr": "21.2.27",
    "marked": "18.1.1",
    "rxjs": "7.8.2",
    "shiki": "4.5.0",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.27",
    "@angular/cli": "21.2.27",
    "@angular/compiler-cli": "21.2.25",
    "@types/node": "22.15.21",
    "jsdom": "28.1.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
